# HireLens Backend Configuration Example
# Copy this file to .env and configure your secret credentials.
# Note: Never commit .env with real secrets to version control.

# Groq API Configuration
# Obtain your API key from Groq Console at: https://console.groq.com/keys
# Official Groq API Base URL: https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here

# Groq Supported Models for Structured Outputs:
# - openai/gpt-oss-120b (Recommended, high reasoning capability, strict schema support)
# - openai/gpt-oss-20b (High speed, efficient, strict schema support)
# - qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Groq API Base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# SQLite Database Configuration (Default: sqlite:///backend/data/hirelens.db)
# Note: For SQLite persistence in cloud environments, mount a persistent volume (e.g. Railway Volume).
# SQLite is designed for a single worker; multiple workers/replicas may encounter database lock errors.
# DATABASE_URL=sqlite:///./data/hirelens.db
#
# Production PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/hirelens

# Allowed CORS Origins (comma-separated for production)
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if not set.
# Note: Never specify wildcard '*' when credentials are enabled.
# ALLOWED_ORIGINS=https://hirelens.vercel.app,http://localhost:3000

# Server Port (optional, defaults to 8000)
# PORT=8000
